# Generated data. Rebuild with the scripts in src/data/. Do not commit these.
# Leading slash: only the top-level data folder, not src/data/.
/data/simulated/

# Raw Banking77 inputs ARE committed (input/*.parquet, input/intents.csv).
# The .arrow copies are duplicates of the parquet files, so skip them.
*.arrow

# Secrets. Leave S3 credentials here if you add them later. Never commit this file.
.env

# Local Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# Local matplotlib cache (MPLCONFIGDIR)
.cache/

/.quarto/
/_site/
**/*.quarto_ipynb

# Metrics rewritten by spark/ml_run.py and python -m src.ml.run.
/ml/output/

# Local EDA tables left from an earlier run. Not part of the shared data.
/data/eda/
